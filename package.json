{
  "name": "agent-black-box",
  "version": "0.13.0",
  "description": "Local-first CLI for reviewing repository changes and risk signals during AI-assisted coding.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.30",
      "brace-expansion": "5.0.12",
      "source-map-js": "1.2.2",
      "vite": "8.3.5"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IACBI/agent-black-box.git"
  },
  "bugs": {
    "url": "https://github.com/IACBI/agent-black-box/issues"
  },
  "homepage": "https://github.com/IACBI/agent-black-box/blob/main/docs/USAGE.md",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "abb": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "schema",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:isolated": "tsx scripts/isolated-audit.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm deadcode && pnpm build && pnpm test:coverage",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx src/cli.ts",
    "deadcode": "pnpm deadcode:reachability && pnpm deadcode:knip",
    "deadcode:knip": "knip --config knip.config.ts",
    "deadcode:reachability": "tsx scripts/dead-code.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache --cache-location .cache/eslint src tests scripts vitest.config.ts",
    "perf": "tsx scripts/performance.ts",
    "release:check": "pnpm check && pnpm audit --prod --audit-level high && pnpm pack --dry-run && pnpm release:validate",
    "release:validate": "tsx scripts/release-check.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "verify:isolation": "tsx scripts/verify-isolation.ts"
  },
  "keywords": [
    "ai",
    "cli",
    "audit",
    "git",
    "developer-tools"
  ],
  "author": "A.C.B",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "simple-git": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.13.0",
    "knip": "6.43.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
